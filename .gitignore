# Veritas Configuration

# LLM Provider: 'anthropic' or 'openai'
VERITAS_PROVIDER=anthropic

# Model selection
# For Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo, etc.
VERITAS_MODEL=claude-3-5-sonnet-20241022

# Temperature: 0 (deterministic) to 1 (creative)
# Lower = more consistent, higher = more creative
VERITAS_TEMPERATURE=0.2

# Max tokens per agent response
VERITAS_MAX_TOKENS=1500

# API Keys
# Get your Anthropic API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# OR get your OpenAI API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_key_here
